{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komikhq-nitro",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "nitro.komikhq.dpdns.org",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_KOMIKHQ",
      "id": "8e9495dce11d4e21a5103d30e96dddca"
    },
    {
      "binding": "KV_VIEWS",
      "id": "6999df4c38084567ac172dbf65ae7395"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET_USERS",
      "bucket_name": "komikhq-users"
    },
    {
      "binding": "BUCKET_MEDIA",
      "bucket_name": "komikhq-media"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "AE_COMIC_VIEWS",
      "dataset": "komikhq_views"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 */6 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_PRESENCE_DO",
        "class_name": "GlobalPresenceDO"
      },
      {
        "name": "COMMENT_STREAM_DO",
        "class_name": "CommentStreamDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalPresenceDO",
        "CommentStreamDO"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}